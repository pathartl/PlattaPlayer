<Project Sdk="Microsoft.NET.Sdk">

  <!-- The codec plugin contract. Platform-free and dependency-free: a codec plugin references only this
       assembly, and the host (library scanner, playback engine, tag editor) talks to codecs through it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
