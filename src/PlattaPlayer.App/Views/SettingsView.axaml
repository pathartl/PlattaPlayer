<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlattaPlayer.App.ViewModels"
             xmlns:models="using:PlattaPlayer.Core.Models"
             xmlns:codecs="using:PlattaPlayer.Codecs.Abstractions"
             xmlns:items="using:PlattaPlayer.App.ViewModels.Items"
             xmlns:ctrl="using:PlattaPlayer.App.Controls"
             x:Class="PlattaPlayer.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.SwatchRing">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.SwatchRing.Selected">
            <Setter Property="BorderBrush" Value="{StaticResource TextStrongBrush}" />
        </Style>
        <!-- A source's reindex arrow spins while that source is scanning. -->
        <Style Selector="TextBlock.Spinning">
            <Style.Animations>
                <Animation Duration="0:0:1" IterationCount="INFINITE">
                    <KeyFrame Cue="0%">
                        <Setter Property="RotateTransform.Angle" Value="0" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="RotateTransform.Angle" Value="360" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Margin="32,24">
        <TextBlock Grid.Row="0" Text="Settings" Classes="PageTitle" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="8">
            <TextBlock Text="Sources" Classes="SectionTitle" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- One entry per source type; each opens that type's own add flow. -->
                <Button Background="{StaticResource AccentBrush}" Foreground="{StaticResource OnAccentBrush}"
                        Padding="16,8" CornerRadius="4" IsEnabled="{Binding !IsSyncing}"
                        AutomationProperties.Name="Add source">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" VerticalAlignment="Center" />
                        <TextBlock Text="Add source" VerticalAlignment="Center" />
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem Header="Jellyfin library" Command="{Binding BeginAddJellyfinCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Plex library" Command="{Binding BeginAddPlexCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Emby library" Command="{Binding BeginAddEmbyCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Navidrome library" Command="{Binding BeginAddNavidromeCommand}">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE774;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Local path" Click="OnAddLocalFolder">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button Content="&#xE72C;  Rescan all" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        Command="{Binding RescanAllCommand}" Background="{StaticResource SurfaceBrush}"
                        Foreground="{StaticResource TextPrimaryBrush}" Padding="16,8" CornerRadius="4"
                        IsEnabled="{Binding !IsSyncing}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding SyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="&#xE895;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SyncStatus}" Classes="Secondary" FontSize="13" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Jellyfin login, shown after picking "Jellyfin library" from the Add source menu. -->
            <Border Classes="Card" IsVisible="{Binding IsAddingJellyfin}">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Add Jellyfin library" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding JellyfinServerUrl}" PlaceholderText="Server URL (e.g. http://192.168.1.10:8096)"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding JellyfinUsername}" PlaceholderText="Username"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding JellyfinPassword}" PlaceholderText="Password" PasswordChar="•"
                             IsEnabled="{Binding !IsConnecting}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE703;  Connect" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Command="{Binding ConnectJellyfinCommand}" Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource OnAccentBrush}" Padding="16,8" CornerRadius="4"
                                IsEnabled="{Binding !IsConnecting}" />
                        <Button Content="Cancel" Command="{Binding CancelAddJellyfinCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="16,8" CornerRadius="4" IsEnabled="{Binding !IsConnecting}" />
                    </StackPanel>
                    <TextBlock Text="{Binding JellyfinStatus}" Classes="Secondary" FontSize="13" TextWrapping="Wrap"
                               IsVisible="{Binding JellyfinStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Emby login, shown after picking "Emby library" from the Add source menu. -->
            <Border Classes="Card" IsVisible="{Binding IsAddingEmby}">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Add Emby library" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding EmbyServerUrl}" PlaceholderText="Server URL (e.g. http://192.168.1.10:8096)"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding EmbyUsername}" PlaceholderText="Username"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding EmbyPassword}" PlaceholderText="Password" PasswordChar="•"
                             IsEnabled="{Binding !IsConnecting}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE703;  Connect" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Command="{Binding ConnectEmbyCommand}" Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource OnAccentBrush}" Padding="16,8" CornerRadius="4"
                                IsEnabled="{Binding !IsConnecting}" />
                        <Button Content="Cancel" Command="{Binding CancelAddEmbyCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="16,8" CornerRadius="4" IsEnabled="{Binding !IsConnecting}" />
                    </StackPanel>
                    <TextBlock Text="{Binding EmbyStatus}" Classes="Secondary" FontSize="13" TextWrapping="Wrap"
                               IsVisible="{Binding EmbyStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Navidrome sign-in, shown after picking "Navidrome library" from the Add source menu. -->
            <Border Classes="Card" IsVisible="{Binding IsAddingNavidrome}">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Add Navidrome library" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock Text="Also works with other Subsonic-compatible servers (Airsonic, gonic, …)."
                               Classes="Secondary" FontSize="12" TextWrapping="Wrap" />
                    <TextBox Text="{Binding NavidromeServerUrl}" PlaceholderText="Server URL (e.g. http://192.168.1.10:4533)"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding NavidromeUsername}" PlaceholderText="Username"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding NavidromePassword}" PlaceholderText="Password" PasswordChar="•"
                             IsEnabled="{Binding !IsConnecting}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE703;  Connect" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Command="{Binding ConnectNavidromeCommand}" Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource OnAccentBrush}" Padding="16,8" CornerRadius="4"
                                IsEnabled="{Binding !IsConnecting}" />
                        <Button Content="Cancel" Command="{Binding CancelAddNavidromeCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="16,8" CornerRadius="4" IsEnabled="{Binding !IsConnecting}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NavidromeStatus}" Classes="Secondary" FontSize="13" TextWrapping="Wrap"
                               IsVisible="{Binding NavidromeStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <!-- Plex sign-in, shown after picking "Plex library" from the Add source menu. -->
            <Border Classes="Card" IsVisible="{Binding IsAddingPlex}">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Add Plex library" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBox Text="{Binding PlexServerUrl}" PlaceholderText="Server URL (optional, e.g. http://192.168.1.10:32400)"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding PlexUsername}" PlaceholderText="Plex username or email"
                             IsEnabled="{Binding !IsConnecting}" />
                    <TextBox Text="{Binding PlexPassword}" PlaceholderText="Password (append your 2FA code if enabled)" PasswordChar="•"
                             IsEnabled="{Binding !IsConnecting}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="&#xE703;  Connect" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Command="{Binding ConnectPlexCommand}" Background="{StaticResource AccentBrush}"
                                Foreground="{StaticResource OnAccentBrush}" Padding="16,8" CornerRadius="4"
                                IsEnabled="{Binding !IsConnecting}" />
                        <Button Content="&#xE774;  Sign in with browser" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                Click="OnPlexBrowserSignIn" Background="{StaticResource SurfaceBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}" Padding="16,8" CornerRadius="4"
                                IsEnabled="{Binding !IsConnecting}" />
                        <!-- Stays enabled while waiting on the browser, where it abandons the sign-in. -->
                        <Button Content="Cancel" Command="{Binding CancelAddPlexCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="16,8" CornerRadius="4">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                    <Binding Path="!IsConnecting" />
                                    <Binding Path="IsAwaitingPlexBrowser" />
                                </MultiBinding>
                            </Button.IsEnabled>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding PlexStatus}" Classes="Secondary" FontSize="13" TextWrapping="Wrap"
                               IsVisible="{Binding PlexStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="No sources configured yet." Classes="Secondary" FontSize="14"
                       IsVisible="{Binding !Sources.Count}" />
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:SourceItemViewModel">
                        <Border Classes="Card" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="20" Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center" Margin="4,0,12,0" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding TypeLabel}" Classes="Secondary" FontSize="12" />
                                </StackPanel>
                                <Button Grid.Column="2" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0" Padding="8" ToolTip.Tip="Reindex this source"
                                        IsEnabled="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).IsSyncing, Converter={x:Static BoolConverters.Not}}"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RescanSourceCommand}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE72C;" Classes.Spinning="{Binding IsSyncing}"
                                               RenderTransformOrigin="50%,50%">
                                        <TextBlock.RenderTransform>
                                            <RotateTransform />
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </Button>
                                <Button Grid.Column="3" Content="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                        BorderThickness="0" Padding="8" ToolTip.Tip="Remove"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemoveSourceCommand}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Streaming" Classes="SectionTitle" Margin="0,12,0,0" />
            <Border Classes="Card">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <CheckBox Content="Show waveform on the seek bar for media server tracks"
                              IsChecked="{Binding ShowRemoteWaveforms}" />
                    <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                               Text="Downloads each track a second time in the background to draw it. Takes effect from the next track." />
                </StackPanel>
            </Border>

            <TextBlock Text="Appearance" Classes="SectionTitle" Margin="0,12,0,0" />
            <Border Classes="Card">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Accent color" Classes="Secondary" FontSize="13" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                    <ItemsControl ItemsSource="{Binding AccentSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccentSwatch">
                                <Button Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="17"
                                        ToolTip.Tip="{Binding Name}"
                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectAccentCommand}"
                                        CommandParameter="{Binding}">
                                    <!-- Selection ring around the swatch dot. -->
                                    <Border Classes="SwatchRing" Classes.Selected="{Binding IsSelected}">
                                        <Ellipse Width="24" Height="24" Fill="{Binding Brush}" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Custom color: a hue-wheel dot that opens the full picker. -->
                    <Button Background="Transparent" BorderThickness="0" Padding="0" CornerRadius="17"
                            ToolTip.Tip="Custom color…">
                        <Border Classes="SwatchRing" Classes.Selected="{Binding IsCustomAccent}">
                            <Ellipse Width="24" Height="24">
                                <Ellipse.Fill>
                                    <ConicGradientBrush>
                                        <GradientStop Offset="0" Color="#FF0000" />
                                        <GradientStop Offset="0.167" Color="#FFFF00" />
                                        <GradientStop Offset="0.333" Color="#00FF00" />
                                        <GradientStop Offset="0.5" Color="#00FFFF" />
                                        <GradientStop Offset="0.667" Color="#0000FF" />
                                        <GradientStop Offset="0.833" Color="#FF00FF" />
                                        <GradientStop Offset="1" Color="#FF0000" />
                                    </ConicGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                        </Border>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft">
                                <ColorView Color="{Binding AccentColorValue, Mode=TwoWay}"
                                           IsAlphaEnabled="False" IsAlphaVisible="False"
                                           IsColorPaletteVisible="False" IsAccentColorsVisible="False" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding AccentHex}" PlaceholderText="#RRGGBB" MaxLength="7"
                                 FontFamily="{StaticResource MonoFont}" />
                        <Button Grid.Column="2" Content="Reset" Command="{Binding ResetAccentCommand}"
                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                Padding="12,8" CornerRadius="4" />
                    </Grid>
                    <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                               Text="Pick a swatch or enter any hex color. Used for playing/active state, sliders and primary buttons." />
                </StackPanel>
            </Border>

            <TextBlock Text="Navigation rail" Classes="SectionTitle" Margin="0,12,0,0" />
            <Border Classes="Card">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Shown in the rail, top to bottom" Classes="Secondary" FontSize="13" />
                    <ItemsControl ItemsSource="{Binding Rail.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:NavRailItemViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Width="320">
                                    <CheckBox IsChecked="{Binding IsShown}">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <ctrl:LineIcon Data="{Binding Icon}" Size="16" />
                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <Button Grid.Column="1" Content="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderThickness="0" Padding="8" ToolTip.Tip="Move up"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Move {0} up'}"
                                            IsEnabled="{Binding CanMoveUp}"
                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).Rail.MoveUpCommand}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2" Content="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                            Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                            BorderThickness="0" Padding="8" ToolTip.Tip="Move down"
                                            AutomationProperties.Name="{Binding Label, StringFormat='Move {0} down'}"
                                            IsEnabled="{Binding CanMoveDown}"
                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).Rail.MoveDownCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Pinned to the bottom" Classes="Secondary" FontSize="13" Margin="0,8,0,0" />
                    <ItemsControl ItemsSource="{Binding Rail.PinnedItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:NavRailItemViewModel">
                                <CheckBox IsChecked="{Binding IsShown}">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <ctrl:LineIcon Data="{Binding Icon}" Size="16" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="Reset to default" Command="{Binding Rail.ResetToDefaultCommand}"
                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                            Padding="12,8" CornerRadius="4" Margin="0,4,0,0" />
                    <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                               Text="Settings always stays in the rail. The source filter only appears once a source is added." />
                </StackPanel>
            </Border>

            <!-- Codec plugin settings, e.g. the MIDI codec's default device: one section per setting. -->
            <ItemsControl ItemsSource="{Binding CodecSettings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:CodecSettingViewModel">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <TextBlock Text="{Binding Title}" Classes="SectionTitle" />
                            <Border Classes="Card">
                                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Label}" Classes="Secondary" FontSize="13" />
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                        <ComboBox Grid.Column="0" HorizontalAlignment="Stretch"
                                                  ItemsSource="{Binding Choices}"
                                                  SelectedItem="{Binding Selected}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="codecs:CodecChoice">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Folders}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="codecs:CodecFolder">
                                                    <Button Content="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                            Click="OnOpenCodecFolder" Tag="{Binding Path}"
                                                            ToolTip.Tip="{Binding Label, StringFormat='Open {0}'}"
                                                            Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                            Padding="12,8" CornerRadius="4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                Command="{Binding RefreshCommand}" ToolTip.Tip="Rescan"
                                                Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                                                Padding="12,8" CornerRadius="4" />
                                    </Grid>
                                    <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                                               Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                                    <ItemsControl ItemsSource="{Binding Folders}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="codecs:CodecFolder">
                                                <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap" Text="{Binding Path}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="Visualizer" Classes="SectionTitle" Margin="0,12,0,0" />
            <Border Classes="Card">
                <StackPanel Spacing="8" MaxWidth="420" HorizontalAlignment="Left">
                    <TextBlock Text="Full-window visualizer" Classes="Secondary" FontSize="13" />
                    <ComboBox HorizontalAlignment="Stretch"
                              ItemsSource="{Binding Visualization.AvailableVisualizers}"
                              SelectedItem="{Binding Visualization.ActiveVisualizer}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DisplayName}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Classes="Secondary" FontSize="12" TextWrapping="Wrap"
                               Text="Choose which animated background plays behind the app while audio is playing." />
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
