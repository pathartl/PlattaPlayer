<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PlattaPlayer.App.ViewModels"
             xmlns:items="using:PlattaPlayer.App.ViewModels.Items"
             xmlns:conv="using:PlattaPlayer.App.Converters"
             x:Class="PlattaPlayer.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <ScrollViewer Name="PageScroller" Padding="32,24">
        <StackPanel Spacing="8">
            <TextBlock Text="Home" Classes="PageTitle" />

            <TextBlock Text="No music yet. Add a local folder in Settings to get started."
                       Classes="Secondary" FontSize="15" Margin="0,8"
                       IsVisible="{Binding !HasContent}" />

            <StackPanel IsVisible="{Binding HasContent}" Spacing="8">
                <TextBlock Text="Recently Added" Classes="SectionTitle" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentlyAdded}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:AlbumItemViewModel">
                                <Button Classes="Tile" Width="160"
                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAlbumCommand}"
                                        CommandParameter="{Binding Id}">
                                    <StackPanel Spacing="8">
                                        <Panel Width="140" Height="140">
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                                <TextBlock Text="&#xE93C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="40" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding CoverPath, Converter={x:Static conv:CoverImageConverter.Instance}}"
                                                   Stretch="UniformToFill">
                                                <Image.Clip><RectangleGeometry Rect="0,0,140,140" RadiusX="6" RadiusY="6" /></Image.Clip>
                                            </Image>
                                        </Panel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Classes="Link" CommandParameter="{Binding ArtistId}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToArtistCommand}">
                                            <TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Recently Played" Classes="SectionTitle" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding RecentlyPlayed}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:TrackItemViewModel">
                                <Button Classes="Tile" Width="160"
                                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).PlayCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="8">
                                        <Panel Width="140" Height="140">
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="40" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding CoverPath, Converter={x:Static conv:CoverImageConverter.Instance}}"
                                                   Stretch="UniformToFill">
                                                <Image.Clip><RectangleGeometry Rect="0,0,140,140" RadiusX="6" RadiusY="6" /></Image.Clip>
                                            </Image>
                                        </Panel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Classes="Link" CommandParameter="{Binding ArtistId}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToArtistCommand}">
                                            <TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="Most Played" Classes="SectionTitle" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MostPlayed}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="14" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="items:TrackItemViewModel">
                                <Button Classes="Tile" Width="160"
                                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).PlayCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="8">
                                        <Panel Width="140" Height="140">
                                            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="6">
                                                <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="40" Foreground="{StaticResource TextTertiaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Image Source="{Binding CoverPath, Converter={x:Static conv:CoverImageConverter.Instance}}"
                                                   Stretch="UniformToFill">
                                                <Image.Clip><RectangleGeometry Rect="0,0,140,140" RadiusX="6" RadiusY="6" /></Image.Clip>
                                            </Image>
                                        </Panel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <Button Classes="Link" CommandParameter="{Binding ArtistId}"
                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToArtistCommand}">
                                            <TextBlock Text="{Binding Artist}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
