<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:PlattaPlayer.App.ViewModels"
        xmlns:items="using:PlattaPlayer.App.ViewModels.Items"
        xmlns:conv="using:PlattaPlayer.App.Converters"
        xmlns:ctrl="using:PlattaPlayer.App.Controls"
        xmlns:views="using:PlattaPlayer.App.Views"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="PlattaPlayer.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="PlattaPlayer"
        Icon="avares://PlattaPlayer.App/Assets/AppIcon.ico"
        Width="1440" Height="900"
        MinWidth="1024" MinHeight="640"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32"
        WindowStartupLocation="CenterScreen"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="14">

    <!-- 1px hairline outline around the frameless window; dropped when maximized/fullscreen (code-behind). -->
    <Border Name="RootBorder"
            BorderBrush="{StaticResource WindowBorderBrush}"
            BorderThickness="1"
            ClipToBounds="True">
    <Panel>

        <!-- ===== Visualizer: always the background =====
             The active plugin's control is placed in VisualizerHost by code-behind. Library screens run it at
             60% under a 28% black scrim; Now Playing at full intensity. -->
        <Panel Name="VisualizerHost" IsVisible="{Binding IsVisualizerVisible}" Opacity="{Binding VisualizerOpacity}">
            <Panel.Transitions>
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
            </Panel.Transitions>
        </Panel>
        <Border Background="{StaticResource VizScrimLibraryBrush}" IsHitTestVisible="False"
                IsVisible="{Binding IsLibraryVisible}" />

        <Grid RowDefinitions="32,*,Auto">

            <!-- ===== Title bar =====
                 Glass like the rail and transport bar on library screens (a separate backdrop so it can be a
                 blur target); bare over the visualizer in Now Playing. -->
            <Border Grid.Row="0" Name="TitleBarGlass" Classes="Glass" IsVisible="{Binding IsLibraryVisible}"
                    IsHitTestVisible="False"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1" />
            <Grid Grid.Row="0" Name="TitleBar" Background="Transparent" ColumnDefinitions="*,Auto"
                  chrome:WindowDecorationProperties.ElementRole="TitleBar">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="14,0,0,0"
                            VerticalAlignment="Center" IsHitTestVisible="False">
                    <ctrl:LineIcon Data="{StaticResource IconLogo}" Size="16" StrokeThickness="2"
                                   Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="PlattaPlayer" FontSize="12" Foreground="#B8FFFFFF" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Name="MinimizeButton" Classes="Caption" ToolTip.Tip="Minimize"
                            AutomationProperties.Name="Minimize"
                            chrome:WindowDecorationProperties.ElementRole="MinimizeButton">
                        <ctrl:LineIcon Data="{StaticResource CaptionMinimize}" Size="10" GridSize="10" StrokeThickness="1" />
                    </Button>
                    <Button Name="MaximizeButton" Classes="Caption" ToolTip.Tip="Maximize"
                            AutomationProperties.Name="Maximize"
                            chrome:WindowDecorationProperties.ElementRole="MaximizeButton">
                        <ctrl:LineIcon Name="MaximizeGlyph" Data="{StaticResource CaptionMaximize}"
                                       Size="10" GridSize="10" StrokeThickness="1" />
                    </Button>
                    <Button Name="CloseButton" Classes="Caption Close" ToolTip.Tip="Close"
                            AutomationProperties.Name="Close"
                            chrome:WindowDecorationProperties.ElementRole="CloseButton">
                        <ctrl:LineIcon Data="{StaticResource CaptionClose}" Size="10" GridSize="10" StrokeThickness="1" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== Library: nav rail + content ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="232,*,Auto">

                <Border Name="NavRail" Classes="Glass" IsVisible="{Binding IsLibraryVisible}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="12,12,12,16">

                        <!-- Search -->
                        <Panel DockPanel.Dock="Top">
                            <TextBox Name="SearchBox" Classes="Search" Text="{Binding SearchText}"
                                     PlaceholderText="Search artists, albums, songs"
                                     AutomationProperties.Name="Search library">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            <ctrl:LineIcon Data="{StaticResource IconSearch}" Size="16" Margin="12,0,0,0"
                                           HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Foreground="#99FFFFFF" IsHitTestVisible="False" />
                        </Panel>

                        <!-- Pinned bottom: source filter, tag editor + settings -->
                        <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                            <Button Classes="NavItem" Margin="0,0,0,6"
                                    ToolTip.Tip="Choose which sources the library shows"
                                    AutomationProperties.Name="Sources shown">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="HasSources" />
                                        <Binding Path="Rail.SourceFilter.IsShown" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <ctrl:LineIcon Data="{StaticResource IconSources}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SourceFilterSummary}" Margin="12,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ctrl:LineIcon Grid.Column="2" Data="{StaticResource IconChevronUpDown}" Size="14"
                                                   Foreground="{StaticResource TextTertiaryBrush}" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <StackPanel Width="240" Spacing="6" Margin="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="Caption" Text="SHOW MUSIC FROM" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Classes="Link" Command="{Binding ShowAllSourcesCommand}">
                                                    <TextBlock Text="Show all" FontSize="12" />
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding SourceFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="items:SourceFilterItemViewModel">
                                                        <CheckBox IsChecked="{Binding IsShown}" ToolTip.Tip="{Binding DisplayName}">
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <RadioButton Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="TagEditor"
                                         IsVisible="{Binding Rail.TagEditor.IsShown}"
                                         IsChecked="{Binding SelectedSection, Mode=OneWay, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=TagEditor}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ctrl:LineIcon Data="{StaticResource IconTag}" />
                                    <TextBlock Text="Tag editor" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton Classes="NavItem" Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                         IsChecked="{Binding SelectedSection, Mode=OneWay, Converter={x:Static conv:StringEqualsConverter.Instance}, ConverterParameter=Settings}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ctrl:LineIcon Data="{StaticResource IconSettings}" />
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sections and the playlists block, in the order (and subset) picked in Settings. -->
                        <ScrollViewer Margin="0,22,0,12" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Rail.ShownItems}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.DataTemplates>
                                    <!-- Playlists: listed before the section template, which would also match it. -->
                                    <DataTemplate DataType="items:NavRailPlaylistsItemViewModel">
                                        <StackPanel Spacing="2" Margin="{Binding GroupMargin}">
                                            <Button Classes="Link" Margin="12,0,0,6"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="Playlists"
                                                    ToolTip.Tip="Manage playlists" Foreground="{StaticResource TextTertiaryBrush}">
                                                <TextBlock Classes="Caption" Text="PLAYLISTS" Foreground="{Binding $parent[Button].Foreground}" />
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Playlists}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="items:PlaylistItemViewModel">
                                                        <RadioButton Classes="NavItem"
                                                                     Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenPlaylistCommand}"
                                                                     CommandParameter="{Binding}">
                                                            <RadioButton.IsChecked>
                                                                <MultiBinding Converter="{x:Static conv:EqualsMultiConverter.Instance}" Mode="OneWay">
                                                                    <Binding Path="SectionKey" />
                                                                    <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SelectedSection" />
                                                                </MultiBinding>
                                                            </RadioButton.IsChecked>
                                                            <Grid ColumnDefinitions="Auto,*">
                                                                <ctrl:LineIcon Data="{StaticResource IconPlaylist}" />
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0"
                                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            </Grid>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Button Classes="NavItem"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                                    CommandParameter="Playlists"
                                                    IsVisible="{Binding !$parent[Window].((vm:MainWindowViewModel)DataContext).Playlists.Count}">
                                                <StackPanel Orientation="Horizontal" Spacing="12">
                                                    <ctrl:LineIcon Data="{StaticResource IconPlaylist}" />
                                                    <TextBlock Text="New playlist…" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>

                                    <!-- A section link; the first run of them is headed "LIBRARY". -->
                                    <DataTemplate DataType="items:NavRailItemViewModel">
                                        <StackPanel Margin="{Binding GroupMargin}">
                                            <TextBlock Classes="Caption" Text="LIBRARY" Margin="12,0,0,8"
                                                       IsVisible="{Binding ShowLibraryCaption}" />
                                            <RadioButton Classes="NavItem"
                                                         Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                                         CommandParameter="{Binding Key}">
                                                <RadioButton.IsChecked>
                                                    <MultiBinding Converter="{x:Static conv:EqualsMultiConverter.Instance}" Mode="OneWay">
                                                        <Binding Path="Key" />
                                                        <Binding Path="$parent[Window].((vm:MainWindowViewModel)DataContext).SelectedSection" />
                                                    </MultiBinding>
                                                </RadioButton.IsChecked>
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <ctrl:LineIcon Data="{Binding Icon}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Classes="Mono" Text="{Binding Count}" FontSize="11"
                                                               Foreground="{StaticResource TextTertiaryBrush}" VerticalAlignment="Center" />
                                                </Grid>
                                            </RadioButton>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsVisible="{Binding IsLibraryVisible}" />

                <!-- Room for the docked queue panel, which is drawn above (so one instance also floats in Now Playing). -->
                <Border Grid.Column="2" Width="{Binding #QueuePanel.Width}" IsVisible="{Binding IsQueueDocked}" />
            </Grid>

            <!-- ===== Transport bar ===== -->
            <views:TransportBar Grid.Row="2" Name="TransportBar" IsVisible="{Binding IsLibraryVisible}" />

            <!-- ===== Now Playing: the visualizer gets the stage ===== -->
            <views:NowPlayingView Grid.Row="1" Grid.RowSpan="2" Name="NowPlayingView"
                                  IsVisible="{Binding IsNowPlayingOpen}" />

            <!-- ===== Queue: docked right of the library page, or a floating card in Now Playing ===== -->
            <views:QueueView Grid.Row="1" Name="QueuePanel"
                             IsVisible="{Binding IsQueueOpen}" Classes.Floating="{Binding IsNowPlayingOpen}" />
        </Grid>

    </Panel>
    </Border>
</Window>
