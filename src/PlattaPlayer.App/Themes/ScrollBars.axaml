<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Replaces Fluent's auto-hiding overlay scrollbar (a 2px sliver that floats over content and only widens
         under the pointer). This one always sits in its own gutter (ScrollViewer.AllowAutoHide=False, set in
         Styles.axaml), and the whole gutter is hit-testable: the thumb spans its full width and clicking the
         track either side of it pages. The pill is drawn narrower than the gutter and widens on hover. No arrow
         buttons. Keep ResponsiveCoverGrid.ScrollBarGutter in sync with ScrollBarSize. -->
    <x:Double x:Key="ScrollBarSize">14</x:Double>

    <ControlTheme x:Key="ScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ScrollBar}" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Root" Background="{TemplateBinding Background}" CornerRadius="7">
                    <Track Name="PART_Track"
                           Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}"
                           Value="{TemplateBinding Value, Mode=TwoWay}"
                           ViewportSize="{TemplateBinding ViewportSize}"
                           Orientation="{TemplateBinding Orientation}"
                           DeferThumbDrag="{TemplateBinding ScrollViewer.IsDeferredScrollingEnabled}">
                        <Track.DecreaseButton>
                            <RepeatButton Name="PART_PageUpButton" Theme="{StaticResource ScrollBarPageButton}" />
                        </Track.DecreaseButton>
                        <Track.IncreaseButton>
                            <RepeatButton Name="PART_PageDownButton" Theme="{StaticResource ScrollBarPageButton}" />
                        </Track.IncreaseButton>
                        <Thumb Name="thumb" Background="Transparent">
                            <Thumb.Template>
                                <ControlTemplate>
                                    <!-- Transparent outer border keeps the full gutter width grabbable. -->
                                    <!-- Pill inset = Padding, fill = Foreground: the theme can't reach into this
                                         template (one /template/ hop per selector), so it styles the Thumb instead. -->
                                    <Border Background="{TemplateBinding Background}">
                                        <Border Margin="{TemplateBinding Padding}" Background="{TemplateBinding Foreground}"
                                                CornerRadius="4" />
                                    </Border>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^:vertical">
            <Setter Property="Width" Value="{DynamicResource ScrollBarSize}" />
            <Setter Property="MinWidth" Value="{DynamicResource ScrollBarSize}" />
        </Style>
        <Style Selector="^:horizontal">
            <Setter Property="Height" Value="{DynamicResource ScrollBarSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource ScrollBarSize}" />
        </Style>
        <!-- Vertical tracks put the decrease side at the bottom unless reversed. -->
        <Style Selector="^:vertical /template/ Track#PART_Track">
            <Setter Property="IsDirectionReversed" Value="True" />
        </Style>
        <Style Selector="^:vertical /template/ Thumb#thumb">
            <Setter Property="MinHeight" Value="32" />
        </Style>
        <Style Selector="^:horizontal /template/ Thumb#thumb">
            <Setter Property="MinWidth" Value="32" />
        </Style>

        <!-- Pill: 6px at rest, 10px while the pointer is over the gutter. -->
        <Style Selector="^ /template/ Thumb#thumb">
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Padding" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^:vertical /template/ Thumb#thumb">
            <Setter Property="Padding" Value="4,2" />
        </Style>
        <Style Selector="^:horizontal /template/ Thumb#thumb">
            <Setter Property="Padding" Value="2,4" />
        </Style>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
        </Style>
        <Style Selector="^:pointerover /template/ Thumb#thumb">
            <Setter Property="Padding" Value="2" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
        <Style Selector="^ /template/ Thumb#thumb:pressed">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
