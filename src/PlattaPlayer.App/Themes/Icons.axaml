    <StreamGeometry x:Key="IconHome">M4,10.5 L12,4 l8,6.5 V19 a1,1 0 0 1 -1,1 h-4.5 v-5.5 h-5 V20 H5 a1,1 0 0 1 -1,-1 Z</StreamGeometry>
