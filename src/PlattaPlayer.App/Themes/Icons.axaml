    <!-- Line icons on a 24×24 grid, drawn by controls:LineIcon with a 1.6 round stroke (or filled for the
         transport glyphs). Taken from the design mockups; circles/rects are written as arcs/paths. -->

    <StreamGeometry x:Key="IconLogo">M3,12 a9,9 0 1 0 18,0 a9,9 0 1 0 -18,0 Z M8,12 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 Z</StreamGeometry>
