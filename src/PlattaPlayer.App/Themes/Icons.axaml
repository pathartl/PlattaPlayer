    <StreamGeometry x:Key="IconComposer">M5,19 l9,-9 M14,10 l2,-6 l4,4 l-6,2</StreamGeometry>
    <StreamGeometry x:Key="IconFolder">M3.5,7.5 a2,2 0 0 1 2,-2 h4 l2,2 h7 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-13 a2,2 0 0 1 -2,-2 Z</StreamGeometry>
