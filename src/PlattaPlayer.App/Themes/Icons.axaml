    <StreamGeometry x:Key="IconSparkle">M12,3 v4 M12,17 v4 M3,12 h4 M17,12 h4 M6,6 l2.5,2.5 M15.5,15.5 L18,18 M6,18 l2.5,-2.5 M15.5,8.5 L18,6</StreamGeometry>

    <!-- Caption glyphs, on a 10×10 grid with a 1px stroke (Windows 11 style). -->
    <StreamGeometry x:Key="CaptionMinimize">M0,5.5 h10</StreamGeometry>
    <StreamGeometry x:Key="CaptionMaximize">M0.5,0.5 h9 v9 h-9 Z</StreamGeometry>
    <StreamGeometry x:Key="CaptionRestore">M0.5,2.5 h7 v7 h-7 Z M2.5,2.5 V0.5 h7 v7 h-2</StreamGeometry>
    <StreamGeometry x:Key="CaptionClose">M0.5,0.5 l9,9 M9.5,0.5 l-9,9</StreamGeometry>

</ResourceDictionary>
