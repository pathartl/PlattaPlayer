  <!-- Dev-only reverse-engineering harness. Deliberately NOT referenced by the app and never staged
       into plugins\ — it exists to drive the real WMP effects and produce ground-truth frames. -->
  <Folder Name="/tools/">
    <Project Path="tools/PlattaPlayer.Wmp.Harness/PlattaPlayer.Wmp.Harness.csproj" />
    <!-- Dev-only: verifies the SPC codec bit-for-bit against snes_spc (see its reference/build.ps1). -->
    <Project Path="tools/PlattaPlayer.Codecs.Spc.Harness/PlattaPlayer.Codecs.Spc.Harness.csproj" />
    <!-- Dev-only: PSF tag tests and real-rip decode / speed / seek checks for the USF codec. -->
    <Project Path="tools/PlattaPlayer.Codecs.Usf.Harness/PlattaPlayer.Codecs.Usf.Harness.csproj" />
    <!-- Dev-only: PSF tag tests and real-rip decode / speed / seek checks for the GSF codec. -->
    <Project Path="tools/PlattaPlayer.Codecs.Gsf.Harness/PlattaPlayer.Codecs.Gsf.Harness.csproj" />
    <!-- Dev-only: verifies the GBS codec against SameBoy (see its reference/build.ps1). -->
    <Project Path="tools/PlattaPlayer.Codecs.Gbs.Harness/PlattaPlayer.Codecs.Gbs.Harness.csproj" />
    <!-- Dev-only: GD3 tag tests, synthetic chip-log playback and real-file decode / speed / seek checks for the VGM codec. -->
    <Project Path="tools/PlattaPlayer.Codecs.Vgm.Harness/PlattaPlayer.Codecs.Vgm.Harness.csproj" />
  </Folder>
</Solution>
